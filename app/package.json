{
  "name": "@baton/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8790 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 8790 --strictPort",
    "e2e:build": "CLOUDFLARE_ENV=e2e vite build --mode e2e",
    "e2e:serve": "npm run e2e:build && npm run db:migrate:e2e && vite preview --port 8790 --strictPort --mode e2e",
    "db:migrate:local": "wrangler d1 migrations apply baton --local",
    "db:migrate:e2e": "rm -rf .wrangler/state-e2e && wrangler d1 migrations apply baton-e2e --local --env e2e --persist-to .wrangler/state-e2e",
    "db:migrate:remote": "wrangler d1 migrations apply baton --remote",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "test:web": "vitest run -c vitest.web.config.ts",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings src/worker/worker-configuration.d.ts",
    "ai:probe": "node scripts/ai-probe.mjs"
  },
  "dependencies": {
    "@baton/shared": "*",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/query-sync-storage-persister": "^5.104.4",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "arctic": "^3.7.0",
    "hono": "^4.13.13",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.2"
  }
}
